DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional AI features
DEEPSEEK_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Optional MySQL deployment (SQLite is the default)
DB_ENGINE=sqlite
DB_NAME=campus_ai_hub
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional SMTP; development prints email to the console
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.qq.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Campus AI Hub <noreply@example.com>
